# Database Configuration
DB_URL=jdbc:postgresql://postgres:5432/coopcredit
DB_USERNAME=postgres
DB_PASSWORD=postgres

# JWT Configuration
JWT_SECRET=mySecretKeyForJWTTokenGenerationMustBeLongEnoughForHS256AlgorithmToWork
JWT_EXPIRATION=86400000
JWT_ISSUER=credit-application-service

# Risk Service Configuration
RISK_SERVICE_URL=http://risk-service:1080
RISK_SERVICE_TIMEOUT=5000
RISK_SERVICE_RETRY_MAX_ATTEMPTS=3
RISK_SERVICE_RETRY_BACKOFF=1000

# Server Configuration
SERVER_PORT=8080
